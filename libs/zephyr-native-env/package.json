{
  "name": "zephyr-native-env",
  "version": "1.4.2",
  "description": "Environment-specific ZE_PUBLIC_* values for React Native hosts and Module Federation remotes deployed with Zephyr",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZephyrCloudIO/zephyr-packages.git",
    "directory": "libs/zephyr-native-env"
  },
  "source": "src/index.ts",
  "files": [
    "src/",
    "lib/",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!lib/**/*.map",
    "!lib/**/*.tsbuildinfo"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.mjs",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/index.d.mts",
        "default": "./lib/module/index.mjs"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/commonjs/index.js"
    },
    "./runtime-plugin": {
      "react-native": "./src/runtime-plugin.ts",
      "import": {
        "types": "./lib/typescript/runtime-plugin.d.mts",
        "default": "./lib/module/runtime-plugin.mjs"
      },
      "require": {
        "types": "./lib/typescript/runtime-plugin.d.ts",
        "default": "./lib/commonjs/runtime-plugin.js"
      },
      "default": "./lib/commonjs/runtime-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "rslib build --lib esm && rslib build --lib cjs --no-clean",
    "patch-version": "pnpm version",
    "dev": "rslib build --watch",
    "test": "rstest run"
  },
  "dependencies": {
    "zephyr-edge-contract": "workspace:*"
  },
  "devDependencies": {
    "@module-federation/runtime": "catalog:module-federation",
    "@rslib/core": "catalog:rslib",
    "@rstest/core": "catalog:rstest",
    "typescript": "catalog:typescript"
  }
}
