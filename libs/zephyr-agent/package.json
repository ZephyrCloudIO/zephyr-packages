{
  "name": "zephyr-agent",
  "version": "1.2.4",
  "description": "Zephyr plugin agent",
  "license": "Apache-2.0",
  "author": {
    "name": "ZephyrCloudIO",
    "url": "https://github.com/ZephyrCloudIO"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZephyrCloudIO/zephyr-packages.git",
    "directory": "libs/zephyr-agent"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/*.map"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node-persist": {
      "import": {
        "types": "./dist/lib/node-persist/index.d.mts",
        "default": "./dist/lib/node-persist/index.mjs"
      },
      "require": {
        "types": "./dist/lib/node-persist/index.d.ts",
        "default": "./dist/lib/node-persist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rslib build --lib esm && rslib build --lib cjs --no-clean",
    "patch-version": "pnpm version",
    "dev": "rslib build --watch",
    "typecheck": "tsc -b",
    "test": "rstest run",
    "test:deployment": "cross-env ZE_RUN_AGENT_DEPLOYMENT_E2E=true rstest run"
  },
  "dependencies": {
    "@bybrave/proper-lockfile2": "catalog:",
    "@toon-format/toon": "catalog:",
    "axios": "catalog:",
    "ci-info": "catalog:",
    "debug": "catalog:",
    "eventsource": "catalog:",
    "https-proxy-agent": "catalog:",
    "jiti": "catalog:",
    "jose": "catalog:",
    "open": "catalog:",
    "zephyr-edge-contract": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "catalog:rslib",
    "@rstest/core": "catalog:rstest",
    "@types/debug": "catalog:",
    "cross-env": "catalog:",
    "typescript": "catalog:typescript"
  }
}
